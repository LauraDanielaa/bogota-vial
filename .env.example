# Copia este archivo como .env y pon los valores reales. El .env nunca se sube a Git.

# --- Base de datos (PostGIS) ---
# DB_HOST: "localhost" para correr scripts desde tu máquina (en Docker se usa "db" automáticamente)
DB_HOST=localhost
# DB_PORT: puerto expuesto en tu máquina (en producción no se expone)
DB_PORT=5433
DB_NAME=bogota_vial
DB_USER=postgres
# En el servidor usa una clave fuerte, p. ej. la salida de: openssl rand -hex 24
DB_PASSWORD=cambiar_esta_clave

# --- Puertos de la app en local (opcionales) ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Mapa ---
# Token público de Mapbox (empieza por pk.). En mapbox.com restríngelo a tu dominio.
MAPBOX_API_KEY=

# --- Solo producción ---
# Dominio sin https:// ni www (Caddy saca el certificado HTTPS para él y para www.)
DOMINIO=
